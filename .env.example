# Database (PostgreSQL / Render Postgres)
DATABASE_URL="postgresql://workai_user:password@localhost:5432/workai_db?schema=public"

# Authentication
AUTH_SECRET="generate-a-secure-random-32-byte-hex-string-for-production"

# AI Providers (At least one recommended for AI generation; platform works deterministically without them)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
DEFAULT_AI_PROVIDER="gemini"
DEFAULT_AI_MODEL="gemini-1.5-flash"

# Analytics & Ads (AdSense is disabled by default; does not render empty ad blocks)
GOOGLE_ANALYTICS_ID=""
ADSENSE_PUBLISHER_ID=""
ADSENSE_ENABLED="false"

# Base Application Settings & Branding
BASE_URL="http://localhost:3000"
CONTACT_EMAIL="contact@workai.example.com"
ADMIN_EMAIL="admin@workai.example.com"

# Email Configuration (Optional - contact submissions are safely stored in DB if absent)
EMAIL_PROVIDER="smtp"
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""

# Observability (Optional)
SENTRY_DSN=""
REDIS_URL=""

# Feature Flags & Protection Limits
RATE_LIMIT_ENABLED="true"
COOKIE_CONSENT_ENABLED="true"
AFFILIATE_TRACKING_ENABLED="true"

# One-time Admin Bootstrap Token (Used with `npm run admin:bootstrap`)
ADMIN_BOOTSTRAP_TOKEN="setup-bootstrap-token-change-in-prod"
